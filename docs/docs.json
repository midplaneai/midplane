{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Midplane",
  "colors": {
    "primary": "#1d4eff",
    "light": "#5a7dff",
    "dark": "#1d4eff"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/wordmark.svg",
    "dark": "/logo/wordmark-on-dark.svg"
  },
  "seo": {
    "organization": {
      "url": "https://midplane.ai",
      "sameAs": ["https://x.com/midplaneai", "https://github.com/midplaneai"]
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "how-it-works", "get-started"]
          },
          {
            "group": "Prepare your database",
            "pages": [
              "prepare-database",
              "prepare-database/supabase",
              "prepare-database/neon",
              "prepare-database/rds",
              "prepare-database/railway"
            ]
          },
          {
            "group": "Run the gateway",
            "pages": ["gateway/deploy", "gateway/multiple-gateways"]
          },
          {
            "group": "Help",
            "pages": ["troubleshooting"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Gateway",
            "pages": [
              "gateway/configuration",
              "gateway/linked-mode",
              "gateway/local-mode",
              "gateway/secrets",
              "gateway/hosted-agents",
              "gateway/operations"
            ]
          },
          {
            "group": "Policies",
            "pages": ["policies/masking", "policies/approvals-and-taint"]
          },
          {
            "group": "Audit and releases",
            "pages": ["audit", "releases"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/midplaneai/midplane",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/midplaneai/midplane"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://eu.app.midplane.ai"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/midplaneai",
      "github": "https://github.com/midplaneai/midplane"
    }
  },
