{
  "name": "midplane",
  "version": "0.20.0",
  "description": "Postgres MCP server for AI agents, over stdio + Streamable HTTP. Connect the tables you've been keeping off-limits: PII masked at the source, policy enforced on the SQL AST, writes held for human approval, everything audited.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "postgres",
    "sql",
    "ai-agents",
    "guardrails",
    "audit"
  ],
  "homepage": "https://midplane.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midplaneai/midplane.git",
    "directory": "engine/packages/mcp-server"
  },
  "bugs": "https://github.com/midplaneai/midplane/issues",
  "license": "MIT",
  "type": "module",
  "mcpName": "ai.midplane/midplane",
  "main": "dist/cli.js",
  "bin": {
    "midplane": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:npm": "bun scripts/build-npm.ts",
    "qa:wizard": "bun scripts/qa/drive-init-wizard.ts",
    "prepublishOnly": "bun scripts/build-npm.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^4.1.0",
    "libpg-query": "^16.7.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "ulid": "^2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@midplane/engine": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=22.16",
    "bun": ">=1.3.0"
  }
}
