{
  "name": "midplane-oss",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.16.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome ci .",
    "boundaries": "node scripts/check-boundaries.ts .",
    "test": "vitest run",
    "ci": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
