{
  "description": "Statement kinds: which are supported and in which write class, and which are refused (session state, server side effects, non-table DDL, TEMP tables) before any policy applies. Converted from the old engine's exec-side-effects suite and the statement-kind half of dangerous-statement, plus the v2 kind list.",
  "catalog": "app",
  "policies": {
    "read_all": {
      "table_access": {
        "default": "read"
      }
    },
    "rw": {
      "table_access": {
        "default": "read_write"
      }
    },
    "rw_ddl": {
      "table_access": {
        "default": "read_write"
      },
      "writes": {
        "schema_changes": "allow"
      }
    },
    "rw_hold_all": {
      "table_access": {
        "default": "read_write"
      },
      "writes": {
        "row_changes": "hold",
        "schema_changes": "hold"
      }
    }
  },
  "defaults": {
    "policy": "read_all"
  },
  "cases": [
