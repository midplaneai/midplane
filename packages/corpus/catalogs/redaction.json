      "definition": "SELECT id, '4711 days'::interval AS i, 's3cr3t'::varchar(10) AS v, 47.11::numeric(10,2) AS n, '{s3cr3t}'::text[] AS a, B'10100111' AS b, X'1F2E' AS x, -4711 AS neg, 4711e3 AS sci FROM public.accounts"
